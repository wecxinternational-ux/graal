# ── Обязательное ──────────────────────────────────────────────
# Секрет для подписи JWT. ОБЯЗАТЕЛЬНО задать своим значением:
# без него используется общеизвестное значение по умолчанию,
# и токен ГМ можно подделать.
#   openssl rand -hex 32
JWT_SECRET=

# ── Необязательное ────────────────────────────────────────────
# Порт HTTP-сервера (по умолчанию 3000).
PORT=3000

# Интерфейс, который слушать (по умолчанию 0.0.0.0).
HOST=0.0.0.0

# Путь к файлу локальной БД SQLite.
# По умолчанию — server/graal.db рядом с кодом.
#DB_FILE=/var/lib/graal/graal.db

# ── Удалённая БД (не требуется при локальной установке) ────────
# Если задать TURSO_DATABASE_URL, вместо локального файла
# используется удалённая база Turso.
#TURSO_DATABASE_URL=
#TURSO_AUTH_TOKEN=
